{
	"name": "n8n-nodes-twittrapi",
	"version": "1.0.0",
	"description": "n8n community node for TwittrAPI: read public Twitter/X tweets, profiles, followers and search results. Pay as you go from $0.065 per 1,000 calls.",
	"license": "MIT",
	"homepage": "https://www.twittrapi.com",
	"keywords": [
		"n8n-community-node-package",
		"twitter api",
		"x api",
		"twitter scraper",
		"tweets",
		"twitter search",
		"twitter followers",
		"social media data",
		"twittrapi",
		"n8n"
	],
	"author": {
		"name": "TwittrAPI",
		"email": "vipertools@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twittrapi/n8n-nodes-twittrapi.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/*.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TwittrApiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/TwittrApi/TwittrApi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.52.3",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "21.1.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
